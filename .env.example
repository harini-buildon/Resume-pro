# ============================================================
# ResumePro – Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Flask secret key – CHANGE THIS to a long random string in production!
SECRET_KEY=your_secure_secret_key_here

# Gemini AI API key – get one at https://aistudio.google.com/app/apikey
# Without this, AI features (cover letter, interview questions) will use fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Supabase / Neon database URL (optional – leave blank for SQLite)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Redis URL for shared rate-limiting across gunicorn workers (optional)
# Example: redis://localhost:6379/0 or rediss://user:pass@host:6380/0
# If not set, rate limiting falls back to in-memory (per-worker only).
REDIS_URL=
